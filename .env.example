# Copy to .env (gitignored); serve.py reads it at startup. Real environment variables win.
GEMINI_API_KEY=
# Optional: leave blank and the server picks from /v1beta/models by preference at startup
GEMINI_IMAGE_MODEL=
GEMINI_TEXT_MODEL=
# Optional: portrait size 1K (default, ~1344x768 at 16:9) or 2K (sharper, twice as slow)
GEMINI_IMAGE_SIZE=
