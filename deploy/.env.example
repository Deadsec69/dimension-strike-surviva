# Copy to deploy/.env on the droplet and fill in. deploy/.env is gitignored and must never be committed.

# Leave DOMAIN blank to run on the droplet's IP with no domain at all: setup.sh derives
# <dashed-ip>.sslip.io, a free service that resolves 134-209-1-2.sslip.io to 134.209.1.2. The hostname
# is the address, nothing is registered, and because it is still a real name Caddy can obtain a real
# certificate - which the camera requires, since getUserMedia will not run over plain http.
#
# Set it only if you own a domain and would rather use that (A record -> this droplet's IPv4).
DOMAIN=

# Your Gemini key. Leave blank and the board still records every run; portraits simply stay empty.
GEMINI_API_KEY=

# Clearing the leaderboard requires this. Generate one with: openssl rand -hex 24
# Unlock the controls by visiting https://<your domain>/?admin=<this value> once.
DS_ADMIN_TOKEN=

# Free portraits on your key per visitor, and the limits that sit behind them.
DS_FREE_PORTRAITS=1
DS_FP_PER_DAY=3
DS_GLOBAL_PER_DAY=60
DS_RUNS_PER_HOUR=30
