# Detect text vs binary by content by default
* text=auto

# These must be LF: a CRLF shell script fails on Linux with
# "bad interpreter: /usr/bin/env bash^M", and the deploy target is Linux
*.sh   text eol=lf
*.py   text eol=lf
*.js   text eol=lf
*.mjs  text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md   text eol=lf

# Binary artifacts: no line-ending conversion at all
*.wasm binary
*.task binary
